<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app bundle's manifest. `ios/build.sh` copies this in next to the
     binary and fills in the platform it was built for. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Sandy 3</string>
    <key>CFBundleDisplayName</key>
    <string>Sandy 3</string>
    <key>CFBundleIdentifier</key>
    <string>com.playforge.sandy3</string>
    <key>CFBundleExecutable</key>
    <string>sandy-3</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>__PLATFORM__</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>16.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <!-- Without a launch screen iOS runs the app letterboxed at an old
         phone's size. An empty one means the whole screen. -->
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Upright only: the world is built in the shape of the screen when the
         app opens, so turning the phone would stretch it. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>
    <!-- The app's Documents folder shows in the Files app, which is where
         the plugins folder and the captures folder live. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
